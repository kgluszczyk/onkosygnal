---
import { ui } from '../../i18n/ui';
import { sources } from '../../lib/kb';
const updated = sources.map((s) => s.retrieved).sort().at(-1);
---
<footer>
  <div class="wrap colophon">
    <div class="stack">
      <p style="font-family:var(--font-display);font-variation-settings:var(--fraunces-title);font-size:var(--step-1);color:var(--text-1);max-width:46ch;">
        {ui.closing}
      </p>
      <p style="color:var(--text-2);max-width:60ch;">{ui.footer}</p>

      <div style="margin-top:var(--space-4);">
        <p class="eyebrow" style="margin-bottom:var(--space-2);">Źródła</p>
        {sources.map((s) => (
          <span class="receipt" style="display:block;margin-top:2px;">
            źródło: <a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}</a> · {s.country} · akt. {s.retrieved}
          </span>
        ))}
      </div>

      <p class="receipt" style="display:block;margin-top:var(--space-4);">
        OnkoSygnał · narzędzie edukacyjne, nie diagnoza · ostatnia aktualizacja danych: {updated}
      </p>
      <p style="margin-top:var(--space-3);display:flex;gap:var(--space-4);flex-wrap:wrap;">
        <a class="nav__link" href="/o-projekcie">O projekcie</a>
        <a class="nav__link" href="/prywatnosc">Prywatność</a>
        <a class="nav__link" href="/regulamin">Regulamin</a>
      </p>
    </div>
  </div>
</footer>
