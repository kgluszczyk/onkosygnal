---
import { ui } from '../../i18n/ui';
---
<header class="bg-white border-b border-slate-200">
  <nav class="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/" class="font-semibold text-lg" style="color: var(--brand-ink)">
      {ui.siteName}
    </a>
    <div class="flex gap-4 text-sm text-slate-600">
      <a href="/" class="hover:text-slate-900">{ui.nav.home}</a>
      <a href="/o-projekcie" class="hover:text-slate-900">{ui.nav.about}</a>
    </div>
  </nav>
</header>
