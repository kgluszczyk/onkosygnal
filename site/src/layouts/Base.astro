---
// Self-hosted fonts (latin-ext) — Fraunces (display, variable), Fira Sans (body), IBM Plex Mono (data).
import '@fontsource-variable/fraunces/full.css';
import '@fontsource/fira-sans/latin-ext-400.css';
import '@fontsource/fira-sans/latin-ext-500.css';
import '@fontsource/fira-sans/latin-ext-600.css';
import '@fontsource/fira-sans/latin-ext-700.css';
import '@fontsource/ibm-plex-mono/latin-ext-400.css';
import '@fontsource/ibm-plex-mono/latin-ext-500.css';
import '@fontsource/ibm-plex-mono/latin-ext-600.css';
import '../styles/global.css';
import NavBar from '../components/ds/NavBar.astro';
import Footer from '../components/ds/Footer.astro';
import { ui } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
const pageTitle = title ? `${title} — ${ui.siteName}` : `${ui.siteName} — ${ui.tagline}`;
const desc = description ?? ui.disclaimer;
const cfBeacon = import.meta.env.PUBLIC_CF_BEACON;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#F5F1E8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#201D17" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* No-flash theme: apply saved/system theme before first paint. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('onko-theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    {/* Cloudflare Web Analytics: cookieless, off unless PUBLIC_CF_BEACON is set. SRI intentionally
        omitted — Cloudflare rolls this first-party beacon and publishes no stable hash. */}
    {cfBeacon && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfBeacon })} />
    )}
  </head>
  <body>
    <div class="ambient" aria-hidden="true"></div>
    <a href="#main" class="skip-link">{ui.skipToContent}</a>

    {/* Banderola — persistent, non-dismissible educational disclaimer. */}
    <div class="banderola" role="note" aria-label="Zastrzeżenie">
      <div class="wrap banderola__inner">
        <span class="banderola__dot" aria-hidden="true"></span>
        <span>{ui.banderola}</span>
      </div>
    </div>

    <NavBar />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
