---
// Self-hosted fonts (latin-ext) — Fraunces (display, variable), Fira Sans (body), IBM Plex Mono (data).
import '@fontsource-variable/fraunces/full.css';
import '@fontsource/fira-sans/latin-ext-400.css';
import '@fontsource/fira-sans/latin-ext-500.css';
import '@fontsource/fira-sans/latin-ext-600.css';
import '@fontsource/fira-sans/latin-ext-700.css';
import '@fontsource/ibm-plex-mono/latin-ext-400.css';
import '@fontsource/ibm-plex-mono/latin-ext-500.css';
import '@fontsource/ibm-plex-mono/latin-ext-600.css';
import '../styles/global.css';
import NavBar from '../components/ds/NavBar.astro';
import Footer from '../components/ds/Footer.astro';
import { ui } from '../i18n/ui';
import { url } from '../lib/url';
import { canonicalUrl, isDraftRoute, jsonLdScript, medicalWebPageJsonLd } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  /** OpenGraph object type — 'website' for the home page, 'article' for standing content. */
  ogType?: 'website' | 'article';
  /** Extra schema.org nodes for this page (e.g. a FAQPage), emitted beside MedicalWebPage. */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, ogType = 'website', structuredData } = Astro.props;
const pageTitle = title ? `${title} — ${ui.siteName}` : `${ui.siteName} — ${ui.tagline}`;
const desc = description ?? ui.disclaimer;
const cfBeacon = import.meta.env.PUBLIC_CF_BEACON;

const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const siteUrl = canonicalUrl(url(''), Astro.site);
const ogImage = canonicalUrl(url('og.png'), Astro.site);

// The GitHub Pages build (base '/onkosygnal') is a preview of the same content that lives at
// onkosygnal.pl. Letting it be indexed would put the project in competition with itself, so
// that build asks to stay out of the index; production (base '/') never does.
//
// Draft legal pages are held back too, but only from indexing: they keep 'follow' so the
// crawler still walks their links, and they stay perfectly reachable for anyone who clicks
// through from the footer. What they must not be is the page someone lands on from a search
// for „polityka prywatności OnkoSygnał" while they still say they are not binding.
const isPreviewDeploy = import.meta.env.BASE_URL !== '/';
const robots = isPreviewDeploy
  ? 'noindex, nofollow'
  : isDraftRoute(Astro.url.pathname)
    ? 'noindex, follow'
    : null;

const jsonLdNodes = [
  medicalWebPageJsonLd({ name: pageTitle, description: desc, url: canonical, siteName: ui.siteName, siteUrl }),
  ...(Array.isArray(structuredData) ? structuredData : structuredData ? [structuredData] : []),
];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#F5F1E8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#201D17" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />

    {/* Link previews. One 1200x630 PNG is the size Facebook, X, LinkedIn, Slack, Discord
        and WhatsApp all crop cleanly, so there is a single asset rather than per-platform ones. */}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={ui.siteName} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ui.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ui.ogImageAlt} />

    {/* schema.org: MedicalWebPage on every page, plus whatever the page itself declares. */}
    {jsonLdNodes.map((node) => (
      <script type="application/ld+json" is:inline set:html={jsonLdScript(node)} />
    ))}
    {/* No-flash theme: apply saved/system theme before first paint. */}
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try {
          var t = localStorage.getItem('onko-theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    {/* Cloudflare Web Analytics: cookieless, off unless PUBLIC_CF_BEACON is set. SRI intentionally
        omitted — Cloudflare rolls this first-party beacon and publishes no stable hash. */}
    {cfBeacon && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfBeacon })} />
    )}
  </head>
  <body>
    <div class="ambient" aria-hidden="true"></div>
    <a href="#main" class="skip-link">{ui.skipToContent}</a>

    {/* Banderola — persistent, non-dismissible educational disclaimer. */}
    <div class="banderola" role="note" aria-label="Zastrzeżenie">
      <div class="wrap banderola__inner">
        <span class="banderola__dot" aria-hidden="true"></span>
        <span>{ui.banderola}</span>
      </div>
    </div>

    <NavBar />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <script>
      // Calm scroll-reveal: add .is-in as sections enter view (reduced-motion → reveal instantly).
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll('.reveal:not(.is-in)');
      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
