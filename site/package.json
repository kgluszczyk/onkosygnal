{
  "name": "onkosygnal-site",
  "type": "module",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-data.mjs",
    "predev": "node scripts/sync-data.mjs",
    "prebuild": "node scripts/sync-data.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "precheck": "node scripts/sync-data.mjs",
    "check": "astro check",
    "pretest:unit": "node scripts/sync-data.mjs",
    "test:unit": "vitest run",
    "deploy:preview": "npm run build && npx wrangler pages deploy dist --project-name=onkosygnal --branch=preview --commit-dirty=true",
    "deploy:prod": "npm run build && npx wrangler pages deploy dist --project-name=onkosygnal --branch=main --commit-dirty=true"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "wrangler": "^3.99.0"
  }
}
